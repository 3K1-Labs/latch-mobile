# Copy to .env and fill in. env.js validates this at build time and fails with
# the name of anything required that is missing.
#
# Everything under "Required" is what it takes to build and run against Stellar
# testnet — that is all you need to work on the app. The optional sections below
# unlock specific features and fail at the point of use if absent, so leave them
# blank until you need them.

# ─── Required ─────────────────────────────────────────────────────────────────

# "staging" or "production" — selects app name, icon and bundle identifier.
EXPO_PUBLIC_APP_ENV=staging
# Build profile passed through to app.config.js. Defaults to "staging".
EXPO_PUBLIC_APP_PROFILE=staging

# latch-api. Run it locally (see its README) or point at a shared deployment.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Stellar testnet. The passphrase must match the network the RPC serves.
EXPO_PUBLIC_NETWORK=TESTNET
EXPO_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
EXPO_PUBLIC_HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org
EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# The deployed account factory for the network above. Ask a maintainer for the
# current testnet value — it changes when the contracts are redeployed.
#
# This is the only contract address the app is configured with. Verifier and
# policy-singleton addresses are read from the chain, because a configured copy
# of them goes stale on a redeploy and every signature then fails __check_auth.
EXPO_PUBLIC_FACTORY_ADDRESS=

# Relying party ID used when signing with a passkey. This must match latch-api's
# WEBAUTHN_ALLOWED_ORIGINS entry exactly, scheme included, or passkey sign-in
# and account deployment both fail signature verification.
EXPO_PUBLIC_PASSKEY_RP_ID=https://latch.finance

# ─── Optional: mainnet ────────────────────────────────────────────────────────
# Only needed to switch the app to mainnet at runtime. Leave blank for testnet
# work; switching without them gives an error naming the missing variable.

EXPO_PUBLIC_SOROBAN_RPC_URL_MAINNET=
EXPO_PUBLIC_FACTORY_ADDRESS_MAINNET=

# ─── Optional: wallet backend features ────────────────────────────────────────

EXPO_PUBLIC_WALLET_BACKEND_URL=
EXPO_PUBLIC_USE_WALLET_BACKEND_BALANCES=
EXPO_PUBLIC_MULTISIG_BACKEND_ENABLED=
EXPO_PUBLIC_RELAYER_NETWORKS=
# Which network the deposit relayer is deployed against: testnet | mainnet.
EXPO_PUBLIC_RELAYER_NETWORK=testnet

# ─── Optional: swap / liquidity ───────────────────────────────────────────────

EXPO_PUBLIC_SOROSWAP_API_URL=https://api.soroswap.finance
EXPO_PUBLIC_SOROSWAP_API_KEY=
# Set to any value to use mocked swap quotes instead of calling the aggregator.
EXPO_PUBLIC_SWAP_USE_MOCK=
EXPO_PUBLIC_AQUARIUS_API_URL=
EXPO_PUBLIC_AQUARIUS_API_URL_MAINNET=
EXPO_PUBLIC_AQUARIUS_ROUTER=
EXPO_PUBLIC_AQUARIUS_ROUTER_MAINNET=

# ─── Optional: policy contracts ───────────────────────────────────────────────
# Policies enforce rules on an account (admin quorum, recovery). Distinct from
# the VERIFIER_* addresses, which validate signatures. Ask a maintainer for the
# current testnet addresses.
#
# Installing the admin guard has a strict order: the account's "admin" context
# rule must exist first. Installing the policy on an account without it
# permanently destroys that account's administrability.
EXPO_PUBLIC_ADMIN_GUARD_POLICY=
EXPO_PUBLIC_RECOVERY_POLICY=
# Same, for mainnet. Leave blank and social recovery is hidden on mainnet.
EXPO_PUBLIC_RECOVERY_POLICY_MAINNET=

# ─── Optional: contracts used by admin and demo paths ─────────────────────────

EXPO_PUBLIC_COUNTER_ADDRESS=
EXPO_PUBLIC_SMART_ACCOUNT_WASM_HASH=

# ─── Optional: third-party services ───────────────────────────────────────────

# WalletConnect (Reown) project id — needed to connect to dApps.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
# MoonPay publishable key — needed for the buy/on-ramp flow.
EXPO_PUBLIC_MOONPAY_API_KEY=
# Sentry DSN — crash reporting. Leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Optional: OTA updates (hot-updater) ──────────────────────────────────────
# Only needed to publish or receive over-the-air updates, not to run the app.

EXPO_PUBLIC_HOT_UPDATER_SUPABASE_URL=
EXPO_PUBLIC_HOT_UPDATER_SUPABASE_ANON_KEY=
EXPO_PUBLIC_HOT_UPDATER_SUPABASE_BUCKET_NAME=

# ─── Build-time only (never inlined into the bundle) ──────────────────────────

# Overrides the app's display name. Defaults to "Latch".
APP_NAME=
# Sentry release upload. Only needed when producing a release build.
SENTRY_AUTH_TOKEN=
